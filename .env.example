# Backend
APP_NAME=Scry-X-AI
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Generate with a cryptographically random value; never commit a real signing key.
JWT_SIGNING_KEY=
ACCESS_TOKEN_LIFETIME_MINUTES=15

# Comprehensive Rules files persist locally under backend/data/rules by default.
# Override with an absolute path when needed.
# RULES_STORAGE_DIR=C:/persistent/scry-x-ai/rules

# Persist the Scryfall Oracle bulk card-name index on writable storage if needed.
# CARD_CATALOG_PATH=C:/persistent/scry-x-ai/card-names.json

# local schedules a background refresh; external disables recurring refresh but
# stale-startup verification remains enabled. Refresh interval must be <=24 hours.
RULES_REFRESH_MODE=local
RULES_REFRESH_INTERVAL_HOURS=24
# Set DATABASE_URL in local .env when PostgreSQL is available.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/scry_x_ai
DATABASE_URL=sqlite+pysqlite:///data/scry_x_ai_manual.db

# AI provider configuration is optional. No provider/model is selected by default.
# Supply model identifiers and the matching free/paid classification yourself;
# verify model pricing/status with the provider before use.
# LLM_PRIMARY_PROVIDER=openrouter
# LLM_PRIMARY_MODEL=your-provider-model-id
# LLM_PRIMARY_MODEL_COST=free
# Optional single fallback; both provider and model must be supplied together.
# LLM_FALLBACK_PROVIDER=gemini
# LLM_FALLBACK_MODEL=your-fallback-model-id
# LLM_FALLBACK_MODEL_COST=free
# Keep API keys server-side; never add them to NEXT_PUBLIC_* variables.
# LLM_OPENROUTER_API_KEY=
# LLM_GEMINI_API_KEY=

# Paid models are blocked unless explicitly opted in. Cap is USD/month, maximum 5.
# Paid generations exclusively reserve the remaining budget. Calls are blocked
# below the minimum remaining threshold (default USD 1). Unknown costs consume
# the remaining app budget; this is not a provider billing guarantee.
LLM_PAID_ENABLED=true
LLM_MONTHLY_CAP_USD=20
LLM_PAID_MINIMUM_REMAINING_USD=5
# LLM_REQUEST_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_DELAY_SECONDS=0.25
# LLM_RETRY_MAX_DELAY_SECONDS=2

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_MODEL_COST=paid
LLM_OPENAI_PRICING_MODEL=gpt-4o-mini
LLM_OPENAI_INPUT_PRICE_PER_MILLION_USD=0.15
LLM_OPENAI_CACHED_INPUT_PRICE_PER_MILLION_USD=0.075
LLM_OPENAI_OUTPUT_PRICE_PER_MILLION_USD=0.60
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=https://openai.vocareum.com/v1
